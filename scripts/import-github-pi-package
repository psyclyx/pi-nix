#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage: scripts/import-github-pi-package <alias> <owner/repo[@tag]> [--module <name>] [--category <name>]

If @tag is omitted, the latest v-prefixed tag is used.

Examples:
  scripts/import-github-pi-package todos tintinweb/pi-manage-todo-list --module todos --category ui
  scripts/import-github-pi-package hackerman javierportillo/pi-hackerman@63b0a3ef2c7b14985ffeb6cac44614ba59cd5693 --module hackerman --category themes
USAGE
  exit 2
}

if [ "$#" -lt 2 ]; then
  usage
fi

alias_name=$1
spec=$2
shift 2

module_name=$(printf '%s' "$alias_name" | sed -E 's/-([a-z])/\U\1/g')
category=uncategorized

while [ "$#" -gt 0 ]; do
  case "$1" in
    --module)
      [ "$#" -ge 2 ] || usage
      module_name=$2
      shift 2
      ;;
    --category)
      [ "$#" -ge 2 ] || usage
      category=$2
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

repo=${spec%@*}
tag=
if [[ "$spec" == *@* ]]; then
  tag=${spec##*@}
fi

if [[ "$repo" != */* ]]; then
  printf 'expected owner/repo, got: %s\n' "$repo" >&2
  exit 2
fi

if [ -z "$tag" ]; then
  tag=$(
    git ls-remote --tags --refs "https://github.com/${repo}.git" 'refs/tags/v*' \
      | sed -E 's#.*refs/tags/##' \
      | sort -V \
      | tail -n 1
  )
fi

if [ -z "$tag" ]; then
  printf 'could not determine a v-prefixed tag for %s\n' "$repo" >&2
  exit 1
fi

registry_path=registry/packages.json
tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

bundled_pi_dependency_target() {
  case "$1" in
    @earendil-works/pi-coding-agent)
      printf '@earendil-works/pi-coding-agent\n'
      ;;
    @earendil-works/pi-*)
      printf '%s\n' "$1"
      ;;
    @mariozechner/pi-coding-agent)
      printf '@earendil-works/pi-coding-agent\n'
      ;;
    @mariozechner/pi-agent-core)
      printf '@earendil-works/pi-agent-core\n'
      ;;
    @mariozechner/pi-ai)
      printf '@earendil-works/pi-ai\n'
      ;;
    @mariozechner/pi-tui)
      printf '@earendil-works/pi-tui\n'
      ;;
    *)
      return 1
      ;;
  esac
}

tarball="https://github.com/${repo}/archive/${tag}.tar.gz"
source="git:github.com/${repo}@${tag}"
auto_update=true
if [[ "$tag" =~ ^[0-9a-fA-F]{40}$ ]]; then
  auto_update=false
fi

flat_prefetch=$(nix store prefetch-file --json "$tarball")
unpack_prefetch=$(nix store prefetch-file --unpack --json "$tarball")
flat_hash=$(jq -r '.hash' <<<"$flat_prefetch")
unpack_hash=$(jq -r '.hash' <<<"$unpack_prefetch")
store_path=$(jq -r '.storePath' <<<"$unpack_prefetch")

package_json=$store_path/package.json
package_name=$repo
version=${tag#v}
description=""
node_module_dependencies='{}'
if [ -f "$package_json" ]; then
  package_name=$(jq -r --arg fallback "$package_name" '.name // $fallback' "$package_json")
  version=$(jq -r --arg fallback "$version" '.version // $fallback' "$package_json")
  description=$(jq -r '.description // ""' "$package_json")
  while IFS=$'\t' read -r dependency_name dependency_range; do
    [ -n "$dependency_name" ] || continue
    dependency_alias="${dependency_name}@${dependency_range}"
    if bundled_target=$(bundled_pi_dependency_target "$dependency_name"); then
      dependency_alias="pi:${bundled_target}"
    else
      scripts/import-npm-artifact "$dependency_alias" "${dependency_name}@${dependency_range}"
    fi
    node_module_dependencies=$(jq \
      --arg name "$dependency_name" \
      --arg alias "$dependency_alias" \
      '. + {($name): $alias}' \
      <<<"$node_module_dependencies")
  done < <(
    jq -r '
      ((.dependencies // {}) + (.optionalDependencies // {}) + (.peerDependencies // {}))
      | to_entries[]
      | select((.key // "") != "" and (.value // "") != "")
      | [.key, .value]
      | @tsv
    ' "$package_json"
  )
fi

entry=$(jq -n \
  --arg packageName "$package_name" \
  --arg repo "$repo" \
  --arg tag "$tag" \
  --arg source "$source" \
  --arg tarball "$tarball" \
  --arg hash "$flat_hash" \
  --arg unpackHash "$unpack_hash" \
  --arg version "$version" \
  --arg category "$category" \
  --arg description "$description" \
  --arg module "$module_name" \
  --argjson nodeModuleDependencies "$node_module_dependencies" \
  --argjson autoUpdate "$auto_update" \
  '{
    autoUpdate: $autoUpdate,
    kind: "extension",
    sourceKind: "github",
    package: $packageName,
    githubRepo: $repo,
    ref: $tag,
    source: $source,
    tarball: $tarball,
    hash: $hash,
    unpackHash: $unpackHash,
    version: $version,
    category: $category,
    description: $description,
    module: $module
  }
  + if ($nodeModuleDependencies | length) == 0 then {} else { nodeModuleDependencies: $nodeModuleDependencies } end')

jq \
  --arg alias "$alias_name" \
  --argjson entry "$entry" \
  '.piPackages[$alias] = $entry | .packages |= with_entries(.key as $k | .) | .piPackages |= with_entries(.key as $k | .)' \
  "$registry_path" >"$tmp_dir/packages.json"

jq --sort-keys . "$tmp_dir/packages.json" >"$registry_path"
printf '%s: %s\n' "$alias_name" "$source"
