#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage: scripts/import-npm-artifact <alias> <npm-package[@version]>

Imports a non-Pi npm artifact and its transitive runtime dependencies into
registry.npmPackages.

Examples:
  scripts/import-npm-artifact jiti jiti@2.7.0
  scripts/import-npm-artifact example-lib example-lib@1.0.0
USAGE
  exit 2
}

if [ "$#" -ne 2 ]; then
  usage
fi

alias_name=$1
spec=$2

registry_path=registry/packages.json
tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT
registry_json=$(cat "$registry_path")
declare -A importing

seen_file_for() {
  local alias=$1

  [ -n "${PI_NIX_NPM_IMPORT_SEEN_DIR:-}" ] || return 1
  printf '%s/%s\n' \
    "$PI_NIX_NPM_IMPORT_SEEN_DIR" \
    "$(printf '%s' "$alias" | sha256sum | cut -d' ' -f1)"
}

seen_already() {
  local file

  file=$(seen_file_for "$1") || return 1
  [ -e "$file" ]
}

mark_seen() {
  local file

  file=$(seen_file_for "$1") || return 0
  : >"$file"
}

bundled_pi_dependency_target() {
  case "$1" in
    @earendil-works/pi-coding-agent)
      printf '@earendil-works/pi-coding-agent\n'
      ;;
    @earendil-works/pi-*)
      printf '%s\n' "$1"
      ;;
    @mariozechner/pi-coding-agent)
      printf '@earendil-works/pi-coding-agent\n'
      ;;
    @mariozechner/pi-agent-core)
      printf '@earendil-works/pi-agent-core\n'
      ;;
    @mariozechner/pi-ai)
      printf '@earendil-works/pi-ai\n'
      ;;
    @mariozechner/pi-tui)
      printf '@earendil-works/pi-tui\n'
      ;;
    *)
      return 1
      ;;
  esac
}

import_artifact() {
  local current_alias=$1
  local current_spec=$2
  local metadata name version description tarball source
  local dependencies dependency_map flat_prefetch unpack_prefetch flat_hash unpack_hash entry
  local dependency_name dependency_range dependency_alias bundled_target
  local -a dependency_names dependency_ranges dependency_aliases

  if [ -n "${importing[$current_alias]:-}" ] || seen_already "$current_alias"; then
    return
  fi
  importing[$current_alias]=1

  metadata=$(
    npm view "$current_spec" name version description dist.tarball dist.integrity dependencies optionalDependencies peerDependencies --json \
      | jq 'if type == "array" then last else . end'
  )
  name=$(jq -r '.name' <<<"$metadata")
  version=$(jq -r '.version' <<<"$metadata")
  description=$(jq -r '.description // ""' <<<"$metadata")
  tarball=$(jq -r '."dist.tarball"' <<<"$metadata")
  source="npm:${name}@${version}"

  dependencies=$(jq -c '(.dependencies // {}) + (.optionalDependencies // {}) + (.peerDependencies // {})' <<<"$metadata")
  dependency_map='{}'
  while IFS=$'\t' read -r dependency_name dependency_range; do
    [ -n "$dependency_name" ] || continue
    dependency_alias="${dependency_name}@${dependency_range}"
    if bundled_target=$(bundled_pi_dependency_target "$dependency_name"); then
      dependency_alias="pi:${bundled_target}"
    fi
    dependency_names+=("$dependency_name")
    dependency_ranges+=("$dependency_range")
    dependency_aliases+=("$dependency_alias")
    dependency_map=$(jq \
      --arg name "$dependency_name" \
      --arg alias "$dependency_alias" \
      '. + {($name): $alias}' \
      <<<"$dependency_map")
  done < <(
    jq -r '
      if type == "object" then
        to_entries[]
        | select((.key // "") != "" and (.value // "") != "")
        | [.key, .value]
        | @tsv
      else
        empty
      end
    ' <<<"$dependencies"
  )

  if jq -e \
    --arg alias "$current_alias" \
    --arg source "$source" \
    --argjson dependencies "$dependency_map" \
    '
      . as $root
      | ($root.npmPackages[$alias]? // null) as $entry
      | $entry != null
      and $entry.source == $source
      and (($entry.hash // "") != "")
      and (($entry.unpackHash // "") != "")
      and (($entry.dependencies // {}) == $dependencies)
      and (
        $dependencies
        | to_entries
        | all(.value as $dependencyAlias |
            ($dependencyAlias | startswith("pi:"))
            or ($root.npmPackages[$dependencyAlias]? != null))
      )
    ' <<<"$registry_json" >/dev/null; then
    mark_seen "$current_alias"
    return
  fi

  for i in "${!dependency_names[@]}"; do
    dependency_alias=${dependency_aliases[$i]}
    if [[ "$dependency_alias" != pi:* ]]; then
      import_artifact "$dependency_alias" "${dependency_names[$i]}@${dependency_ranges[$i]}"
    fi
  done

  flat_prefetch=$(nix store prefetch-file --json "$tarball")
  unpack_prefetch=$(nix store prefetch-file --unpack --json "$tarball")
  flat_hash=$(jq -r '.hash' <<<"$flat_prefetch")
  unpack_hash=$(jq -r '.hash' <<<"$unpack_prefetch")

  entry=$(jq -n \
    --arg name "$name" \
    --arg source "$source" \
    --arg tarball "$tarball" \
    --arg hash "$flat_hash" \
    --arg unpackHash "$unpack_hash" \
    --arg version "$version" \
    --arg description "$description" \
    --argjson dependencies "$dependency_map" \
    '{
      autoUpdate: true,
      kind: "npm",
      npmPackage: $name,
      source: $source,
      tarball: $tarball,
      hash: $hash,
      unpackHash: $unpackHash,
      version: $version,
      description: $description
    }
    + if ($dependencies | length) == 0 then {} else { dependencies: $dependencies } end')

  registry_json=$(jq \
    --arg alias "$current_alias" \
    --argjson entry "$entry" \
    '.npmPackages[$alias] = $entry | .npmPackages |= with_entries(.key as $k | .)' \
    <<<"$registry_json")

  printf '%s: %s\n' "$current_alias" "$source"
  mark_seen "$current_alias"
}

import_artifact "$alias_name" "$spec"
jq --sort-keys . <<<"$registry_json" >"$tmp_dir/packages.json"
mv "$tmp_dir/packages.json" "$registry_path"
